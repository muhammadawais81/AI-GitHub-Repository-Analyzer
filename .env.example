# Application
APP_NAME=AI Coding Agent Backend
APP_VERSION=0.4.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Local clone storage (relative to project root unless absolute)
REPOSITORIES_DIR=app/repositories

# Analysis tuning
CLONE_TIMEOUT_SECONDS=120
LARGEST_FILES_LIMIT=10

# Groq (OpenAI-compatible API) — Agents SDK (Phase 2 / 4)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
AGENT_MAX_TURNS=25
AGENT_MAX_FILE_CHARS=120000
AGENT_SEARCH_MAX_MATCHES=50
AGENT_MAX_TOKENS=2000
ANALYSIS_RETRIEVAL_TOP_K=2
RAG_CONTEXT_MAX_CHARS=8000

# RAG / ChromaDB (Phase 3) — local Sentence Transformers (no API key)
# Default: src/aicodingagentbackend/chroma_db
CHROMA_DIR=
CHROMA_COLLECTION=repositories
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
EMBEDDING_BATCH_SIZE=64
